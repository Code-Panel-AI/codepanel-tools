{
	"name": "codepanel",
	"version": "0.3.0",
	"description": "CodePanel's CLI, local MCP server and coding-agent plugin",
	"license": "MIT",
	"type": "module",
	"homepage": "https://codepanel.ai/docs/cli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Code-Panel-AI/codepanel-tools.git"
	},
	"bin": {
		"codepanel": "src/cli/codepanel.ts",
		"codepanel-mcp": "src/mcp/server.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"codepanel": "bun src/cli/codepanel.ts",
		"mcp": "bun src/mcp/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"typescript": "~7.0.2"
	}
}
