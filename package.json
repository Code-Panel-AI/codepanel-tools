{
	"name": "codepanel",
	"version": "0.3.0",
	"description": "Agent-to-agent AI pull request review: a panel of models reviews the PR, then your coding agent reads each finding over MCP, fixes or rebuts it, and rates it.",
	"keywords": [
		"code-review",
		"ai-code-review",
		"agentic-code-review",
		"pull-requests",
		"github",
		"mcp",
		"mcp-server",
		"ai-agents",
		"agent-to-agent",
		"claude-code",
		"codex",
		"cursor"
	],
	"license": "MIT",
	"type": "module",
	"homepage": "https://codepanel.ai/docs/cli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Code-Panel-AI/codepanel-tools.git"
	},
	"bin": {
		"codepanel": "src/cli/codepanel.ts",
		"codepanel-mcp": "src/mcp/server.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"codepanel": "bun src/cli/codepanel.ts",
		"mcp": "bun src/mcp/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"typescript": "~7.0.2"
	}
}
